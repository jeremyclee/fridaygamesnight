# Firebase web config: Firebase console → Project settings → General →
# Your apps → Web app (</>) → SDK setup and configuration. These values are
# public identifiers, not secrets; access is controlled by firestore.rules.
# Copy to .env.local for local development, and add to Vercel → Settings →
# Environment Variables for deployment.
FIREBASE_API_KEY=AIzaSy...
FIREBASE_PROJECT_ID=your-project-id

# Optional. Without the values above, `pnpm dev` stores puzzles in memory.
# DATA_STORE=memory forces that anywhere (the e2e tests use it); DATA_STORE_SEED
# points at a JSON file of starting documents: { "<game>": { "<id>": {...} } }.
# DATA_STORE=memory
# DATA_STORE_SEED=tests/e2e/seed.json
